# Copy this to .env and fill in the real values.

# From https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=your_api_key_here

# Note: the API host and the cloth-VTO endpoint paths are hardcoded in
# app/youcam_client.py (verified against Perfect Corp's docs) — no env
# override needed or read for those anymore.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# For the "Ask a stylist" AI comparison feature (compares two saved
# looks). From https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

FRONTEND_ORIGINS=http://localhost:5173
PORT=4000
